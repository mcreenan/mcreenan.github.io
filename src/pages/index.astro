---
import "../styles/site.css";
import Yard from "../components/Yard.astro";
import Room from "../components/Room.astro";
import Furniture from "../components/Furniture.astro";
import Crt from "../components/Crt.astro";
import Boombox from "../components/Boombox.astro";
import Character from "../components/Character.astro";
import { SITE_TITLE, SITE_DESCRIPTION, currentRole, jobs, links, projects } from "../data/profile";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/images/avatar-256.png", Astro.site);

const nav = [
    { id: "about", label: "about" },
    { id: "now", label: "now" },
    { id: "projects", label: "projects" },
    { id: "experience", label: "work" },
    { id: "contact", label: "contact" },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="theme-color" content="#0c0a24" />
        <title>{SITE_TITLE}</title>
        <meta name="description" content={SITE_DESCRIPTION} />
        <link rel="canonical" href={canonicalURL} />
        <link rel="icon" type="image/png" href="/images/avatar-256.png" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link rel="preload" href="/fonts/vt323.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/images/avatar-cut.webp" as="image" type="image/webp" />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={SITE_TITLE} />
        <meta property="og:description" content={SITE_DESCRIPTION} />
        <meta property="og:image" content={ogImage} />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={SITE_TITLE} />
        <meta name="twitter:description" content={SITE_DESCRIPTION} />
        <meta name="twitter:image" content={ogImage} />
    </head>
    <body>
        <a class="skip" href="#about">Skip to content</a>

        <nav class="topnav" id="topnav" aria-label="Sections">
            <a class="topnav-home" href="#top" aria-label="Back to top"><span class="cursor">▌</span>matt.creenan.me</a>
            <ul>
                {nav.map((n) => <li><a href={`#${n.id}`} data-nav={n.id}>{n.label}</a></li>)}
                <li><a href="/resume" class="topnav-resume">resume</a></li>
            </ul>
        </nav>

        <div class="scene" id="scene">
            <div class="sky" aria-hidden="true"></div>
            <canvas id="stars" class="stars" aria-hidden="true"></canvas>
            <button class="moon" id="moon" type="button" aria-label="The moon. Click to make a wish."></button>
            <div class="clouds" aria-hidden="true"><i></i><i></i><i></i></div>
            <div class="plane" aria-hidden="true"></div>
            <Yard />
            <Room />
            <div class="room-glow" aria-hidden="true"></div>

            <h1 class="marquee">
                <span class="marquee-name">Matt Creenan</span>
                <span class="marquee-sub">software builder · buffalo, ny · vibing after dark</span>
            </h1>

            <Furniture />
            <Crt />
            <div class="mug" aria-hidden="true"><span class="steam"></span><span class="steam"></span></div>
            <Boombox />
            <Character />

            <a class="scroll-cue" href="#about">scroll ▾</a>
            <div class="vignette" aria-hidden="true"></div>
            <div class="scene-dim" aria-hidden="true"></div>
            <div class="crt-noise" aria-hidden="true"></div>
        </div>

        <div class="hero-spacer" id="top"></div>

        <main>
            <section id="about" class="panel">
                <h2 class="prompt"><span>~/about</span> $ cat about.txt</h2>
                <div class="about">
                    <img src="/images/avatar-256.png" alt="Matt's cartoon avatar: glasses, beard, purple shirt" width="128" height="125" loading="lazy" />
                    <div class="prose">
                        <p>
                            Hi, I'm <strong>Matt Creenan</strong> — a 40-ish-year-old software engineer in Buffalo, NY.
                            I've spent 20+ years building across full-stack development, data engineering, and DevOps,
                            and I'm happiest leading the gnarly projects nobody else wants to pick up.
                        </p>
                        <p>
                            Lately I'm obsessed with <em>agentic coding</em>: harnesses, runtimes, and tools that make
                            coding agents faster and more trustworthy by keeping the boring parts deterministic.
                        </p>
                        <p>
                            I'm married with two kids, a dog scared of his own shadow, and a cat that wants to be a dog.
                            Off the clock I'm watching the Bills with my wife and son, or suffering through the Sabres alone.
                        </p>
                    </div>
                </div>
            </section>

            <section id="now" class="panel">
                <h2 class="prompt"><span>~/now</span> $ cat now.txt</h2>
                <div class="now-card">
                    <p class="now-kicker">currently</p>
                    <p class="now-role">{currentRole.title}</p>
                    <p class="now-company">@ {currentRole.company} <span>— a {currentRole.parent} company</span></p>
                </div>
                <div class="prose">
                    <p>
                        Before that I spent four years as a Senior Staff Engineer at Torch, where I shipped a company-wide
                        AI Slack agent, in-product LLM features, and a greenfield frontend platform, and built
                        AI-native engineering workflows with custom agents, skills, and routines.
                    </p>
                    <p>
                        On nights and weekends: the projects below.
                    </p>
                </div>
            </section>

            <section id="projects" class="panel">
                <h2 class="prompt"><span>~/projects</span> $ ls -t</h2>
                <p class="lede">Recent agentic coding work, newest first. Everything's on <a href={links.github}>GitHub</a>.</p>
                <ul class="projects">
                    {
                        projects.map((p, i) => (
                            <li class="project" style={`--i:${i}`}>
                                <a href={p.url} target="_blank" rel="noopener">
                                    <span class="project-head">
                                        <span class="project-name">{p.name}</span>
                                        <span class="project-arrow" aria-hidden="true">↗</span>
                                    </span>
                                    <span class="project-tagline">{p.tagline}</span>
                                    <span class="project-desc">{p.description}</span>
                                    <span class="project-tags">
                                        {p.tags.map((t) => <span>{t}</span>)}
                                    </span>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section id="experience" class="panel">
                <h2 class="prompt"><span>~/work</span> $ tail work.log</h2>
                <ol class="timeline">
                    {
                        jobs.map((j) => (
                            <li>
                                <span class="tl-dates">{j.dates}</span>
                                <div>
                                    <h3>{j.title}</h3>
                                    <p class="tl-company">{j.company}</p>
                                    {j.summary && <p class="tl-summary">{j.summary}</p>}
                                    {j.bullets && (
                                        <ul>
                                            {j.bullets.slice(0, 4).map((b) => <li>{b}</li>)}
                                        </ul>
                                    )}
                                </div>
                            </li>
                        ))
                    }
                </ol>
                <p class="more">
                    <a class="btn" href="/resume">full resume →</a>
                    <a class="btn btn-ghost" href="/resume.pdf">download pdf</a>
                </p>
            </section>

            <section id="contact" class="panel">
                <h2 class="prompt"><span>~/contact</span> $ cat contact.txt</h2>
                <ul class="contact">
                    <li><span>github</span><a href={links.github} target="_blank" rel="noopener">github.com/mcreenan</a></li>
                    <li><span>linkedin</span><a href={links.linkedin} target="_blank" rel="noopener">linkedin.com/in/matt-creenan</a></li>
                    <li><span>bluesky</span><a href={links.bluesky} target="_blank" rel="noopener">@matt.creenan.me</a></li>
                    <li><span>twitter</span><a href={links.twitter} target="_blank" rel="noopener">@mcreenan</a></li>
                    <li>
                        <span>email</span>
                        <a class="email" data-user="mattcreenan" data-domain="gmail.com" href="#contact">mattcreenan [at] gmail [dot] com</a>
                    </li>
                </ul>
            </section>
        </main>

        <footer class="footer">
            <p>built late at night with an agent, astro &amp; bun · <a href="#top">back to the rooftop ↑</a></p>
        </footer>

        <script>
            import { initScene } from "../scripts/scene";
            import { initTerminal } from "../scripts/terminal";

            initTerminal(initScene());

            // Assemble the email at runtime so HTML scrapers only see the obfuscated parts.
            document.querySelectorAll<HTMLAnchorElement>("a.email[data-user][data-domain]").forEach((a) => {
                const addr = `${a.dataset.user}@${a.dataset.domain}`;
                a.href = `mailto:${addr}`;
                a.textContent = addr;
            });

            // The scene stays pinned behind the page; dim it as the sections scroll over.
            const scene = document.getElementById("scene")!;
            const onScroll = () => scene.style.setProperty("--dim", Math.min(window.scrollY / window.innerHeight, 1).toFixed(3));
            window.addEventListener("scroll", onScroll, { passive: true });
            onScroll();

            // Top nav: solid once past the hero, highlight the section in view.
            const topnav = document.getElementById("topnav")!;
            const hero = document.getElementById("top")!;
            new IntersectionObserver(([e]) => topnav.classList.toggle("solid", !e.isIntersecting), {
                rootMargin: "-64px 0px 0px 0px",
            }).observe(hero);

            const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav]");
            const sectionObserver = new IntersectionObserver(
                (entries) => {
                    for (const e of entries) {
                        if (!e.isIntersecting) continue;
                        navLinks.forEach((a) => a.classList.toggle("active", a.dataset.nav === e.target.id));
                    }
                },
                { rootMargin: "-45% 0px -50% 0px" },
            );
            document.querySelectorAll("main section[id]").forEach((s) => sectionObserver.observe(s));
        </script>
    </body>
</html>
