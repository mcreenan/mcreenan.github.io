---
// The sunroom, drawn in a 100×100 box stretched to the viewport in one-point
// perspective toward V. Walls are solid with window openings cut out so the
// yard shows through; strokes use non-scaling widths so trim stays crisp.

const V = { x: 50, y: 44 };
const BACK = { l: 12, r: 88, ceiling: 14, floor: 72 };
const WIN = { top: 24, sill: 58 };

const r2 = (n: number) => Math.round(n * 100) / 100;

// Where a back-wall height meets the left viewport edge (mirrored on the right).
const edge = (y: number) => r2(V.y + (y - V.y) * ((0 - V.x) / (BACK.l - V.x)));
// Height on the left side wall at x, for a given back-wall height.
const side = (y: number, x: number) => r2(edge(y) + (y - edge(y)) * (x / BACK.l));

type Line = { x1: number; y1: number; x2: number; y2: number };
const line = (x1: number, y1: number, x2: number, y2: number): Line => ({ x1, y1, x2, y2 });
const mirrorX = (x: number) => r2(100 - x);
const rect = (x: number, y: number, w: number, h: number) => `M${x},${y} h${w} v${h} h${-w} Z`;
const quad = (pts: [number, number][]) => `M${pts.map((p) => p.join(",")).join(" L")} Z`;

// Openings on the back wall: French double doors, a big slider, and a smaller slider.
const DOOR = { x: 14, y: 21, w: 22, h: BACK.floor - 21 };
const doors = [0, 1].map((i) => {
    const x = DOOR.x + (DOOR.w / 2) * i;
    return { x, glass: { x: r2(x + 1.3), y: 23.4, w: r2(DOOR.w / 2 - 2.6), h: 45.2 } };
});
const windows = [
    { x: 40, w: 22, split: 51 },
    { x: 66, w: 20, split: 76 },
];

// Side-wall windows: a quad between two x positions on each side.
const sideWin = (x0: number, x1: number): [number, number][] => [
    [x0, side(WIN.top, x0)],
    [x1, side(WIN.top, x1)],
    [x1, side(WIN.sill, x1)],
    [x0, side(WIN.sill, x0)],
];
const leftWin = sideWin(2.5, 9.5);
const rightWin = leftWin.map(([x, y]) => [mirrorX(x), y] as [number, number]);

const holes = [
    ...doors.map((d) => rect(d.glass.x, d.glass.y, d.glass.w, d.glass.h)),
    ...windows.map((w) => rect(w.x, WIN.top, w.w, WIN.sill - WIN.top)),
];
const backWall = `${rect(BACK.l, BACK.ceiling, BACK.r - BACK.l, BACK.floor - BACK.ceiling)} ${holes.join(" ")}`;
const leftWall = `${quad([
    [0, edge(BACK.ceiling)],
    [BACK.l, BACK.ceiling],
    [BACK.l, BACK.floor],
    [0, edge(BACK.floor)],
])} ${quad(leftWin)}`;
const rightWall = `${quad([
    [100, edge(BACK.ceiling)],
    [BACK.r, BACK.ceiling],
    [BACK.r, BACK.floor],
    [100, edge(BACK.floor)],
])} ${quad(rightWin)}`;
const ceiling = quad([
    [0, 0],
    [100, 0],
    [100, edge(BACK.ceiling)],
    [BACK.r, BACK.ceiling],
    [BACK.l, BACK.ceiling],
    [0, edge(BACK.ceiling)],
]);

const floorEdge = edge(BACK.floor);
const floorPoly = `${BACK.l},${BACK.floor} ${BACK.r},${BACK.floor} 100,${floorEdge} 100,100 0,100 0,${floorEdge}`;
// Rubber floor tiles: perspective seams plus cross seams that widen toward the viewer.
const tileSeams = [
    ...Array.from({ length: 17 }, (_, i) => {
        const x = -30 + i * 10;
        return line(x, BACK.floor, r2(V.x + (x - V.x) * 2), 100);
    }),
    ...[74.2, 77.2, 81.5, 87.5, 96].map((y) => line(0, y, 100, y)),
];

// White trim.
const frames: Line[] = [];
const box = (x: number, y: number, w: number, h: number) =>
    frames.push(line(x, y, x + w, y), line(x + w, y, x + w, y + h), line(x + w, y + h, x, y + h), line(x, y + h, x, y));
windows.forEach((w) => {
    box(w.x, WIN.top, w.w, WIN.sill - WIN.top);
    frames.push(line(w.split, WIN.top, w.split, WIN.sill));
});
const sideFrame = (pts: [number, number][]) => {
    pts.forEach((p, i) => {
        const q = pts[(i + 1) % pts.length];
        frames.push(line(p[0], p[1], q[0], q[1]));
    });
    const midX = r2((pts[0][0] + pts[1][0]) / 2);
    frames.push(line(midX, r2((pts[0][1] + pts[1][1]) / 2), midX, r2((pts[2][1] + pts[3][1]) / 2)));
};
sideFrame(leftWin);
sideFrame(rightWin);

// Doors: outer frame, the meeting stile, and a 3×5 grid of lites in each.
const doorTrim = [
    line(DOOR.x, DOOR.y + DOOR.h, DOOR.x, DOOR.y),
    line(DOOR.x, DOOR.y, DOOR.x + DOOR.w, DOOR.y),
    line(DOOR.x + DOOR.w, DOOR.y, DOOR.x + DOOR.w, DOOR.y + DOOR.h),
    line(DOOR.x + DOOR.w / 2, DOOR.y, DOOR.x + DOOR.w / 2, DOOR.y + DOOR.h),
];
const lites: Line[] = [];
for (const { glass: g } of doors) {
    for (let c = 1; c < 3; c++) {
        const x = r2(g.x + (g.w * c) / 3);
        lites.push(line(x, g.y, x, g.y + g.h));
    }
    for (let r = 1; r < 5; r++) {
        const y = r2(g.y + (g.h * r) / 5);
        lites.push(line(g.x, y, g.x + g.w, y));
    }
}
const doorSlab = `${rect(DOOR.x, DOOR.y, DOOR.w, DOOR.h)} ${doors.map((d) => rect(d.glass.x, d.glass.y, d.glass.w, d.glass.h)).join(" ")}`;
const knobX = r2(DOOR.x + DOOR.w / 2 - 0.65);

const corners = [line(BACK.l, BACK.ceiling, BACK.l, BACK.floor), line(BACK.r, BACK.ceiling, BACK.r, BACK.floor)];
const crown = [
    line(0, edge(BACK.ceiling), BACK.l, BACK.ceiling),
    line(BACK.l, BACK.ceiling, BACK.r, BACK.ceiling),
    line(BACK.r, BACK.ceiling, 100, edge(BACK.ceiling)),
];
const baseboards = [
    line(0, floorEdge, BACK.l, BACK.floor),
    line(BACK.l, BACK.floor, BACK.r, BACK.floor),
    line(BACK.r, BACK.floor, 100, floorEdge),
];

// String lights: one swag between window/door edges, just under the ceiling.
const SAG = 4;
const HANG = BACK.ceiling + 0.8;
const stops = [BACK.l, 25, 38, 51, 64, 76, BACK.r];
const swags = stops.slice(0, -1).map((x, i) => ({ x0: x, x1: stops[i + 1] }));
const wire = swags.map((s) => `M${s.x0},${HANG} Q${(s.x0 + s.x1) / 2},${HANG + SAG * 2} ${s.x1},${HANG}`).join(" ");
const bulbs = swags.flatMap((s, si) =>
    [0.14, 0.32, 0.5, 0.68, 0.86].map((t, bi) => ({
        x: r2(s.x0 + (s.x1 - s.x0) * t),
        y: r2(HANG + 2 * t * (1 - t) * SAG * 2),
        delay: r2(((si * 5 + bi) * 0.61) % 3),
    })),
);
---

<svg class="room" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <defs>
        <linearGradient id="glass-grad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#bcd4ff" stop-opacity="0.06" />
            <stop offset="0.45" stop-color="#bcd4ff" stop-opacity="0.015" />
            <stop offset="0.5" stop-color="#ffffff" stop-opacity="0.05" />
            <stop offset="0.56" stop-color="#bcd4ff" stop-opacity="0.015" />
            <stop offset="1" stop-color="#ffd9a8" stop-opacity="0.05" />
        </linearGradient>
        <linearGradient id="wall-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#65503f" />
            <stop offset="1" stop-color="#7a5e4b" />
        </linearGradient>
        <clipPath id="floor-clip"><polygon points={floorPoly} /></clipPath>
    </defs>

    <g class="glass">
        {holes.map((h) => <path d={h} fill="url(#glass-grad)" />)}
        <path d={quad(leftWin)} fill="url(#glass-grad)" />
        <path d={quad(rightWin)} fill="url(#glass-grad)" />
    </g>

    <path class="ceiling" d={ceiling} />
    <path class="wall" d={backWall} fill="url(#wall-grad)" fill-rule="evenodd" />
    <path class="wall wall-side" d={leftWall} fill-rule="evenodd" />
    <path class="wall wall-side" d={rightWall} fill-rule="evenodd" />

    <polygon class="floor" points={floorPoly} />
    <g class="tiles" clip-path="url(#floor-clip)">{tileSeams.map((l) => <line {...l} />)}</g>

    <path class="door-slab" d={doorSlab} fill-rule="evenodd" />
    <path class="door-chip" d={`M${knobX - 0.2},38 L${knobX + 0.3},37.2 L${knobX + 0.5},40 L${knobX + 0.1},43.5 L${knobX - 0.3},44.5 L${knobX - 0.4},41 Z`} />
    <g class="trim lites">{lites.map((l) => <line {...l} />)}</g>
    <g class="trim door-trim">{doorTrim.map((l) => <line {...l} />)}</g>
    <line class="knob" x1={knobX} y1="47.5" x2={knobX + 0.01} y2="47.5" />
    <line class="knob" x1={knobX} y1="44.5" x2={knobX + 0.01} y2="44.5" />

    <g class="trim frames">{frames.map((l) => <line {...l} />)}</g>
    <g class="corners">{corners.map((l) => <line {...l} />)}</g>
    <g class="trim crown">{crown.map((l) => <line {...l} />)}</g>
    <g class="trim baseboards">{baseboards.map((l) => <line {...l} />)}</g>
</svg>

<div class="string-lights" aria-hidden="true">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none"><path d={wire} /></svg>
    {bulbs.map((b) => <i style={`left:${b.x}%;top:${b.y}%;animation-delay:${b.delay}s`}></i>)}
</div>
