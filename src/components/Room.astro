        </g>
        <g class="leaves">
            <ellipse cx="30" cy="205" rx="7" ry="4" transform="rotate(-30 30 205)" />
            <ellipse cx="37" cy="235" rx="7" ry="4" transform="rotate(30 37 235)" />
            <ellipse cx="31" cy="262" rx="7" ry="4" transform="rotate(-20 31 262)" />
            <ellipse cx="28" cy="286" rx="6" ry="3.5" transform="rotate(20 28 286)" />
