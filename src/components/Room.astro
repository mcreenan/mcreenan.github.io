---
// A small, cozy room, drawn in a 100×100 box stretched to the viewport in one-point
// perspective toward V. The back wall sits close, so it fills most of the view; its
// window openings are cut out so the yard shows through. Strokes use non-scaling
// widths so trim stays crisp.

import { BACK, DOOR, V, WIN, WINDOWS as windows } from "../data/room";

const r2 = (n: number) => Math.round(n * 100) / 100;

type Line = { x1: number; y1: number; x2: number; y2: number };
const line = (x1: number, y1: number, x2: number, y2: number): Line => ({ x1, y1, x2, y2 });
const rect = (x: number, y: number, w: number, h: number) => `M${x},${y} h${w} v${h} h${-w} Z`;
const quad = (pts: [number, number][]) => `M${pts.map((p) => p.join(",")).join(" L")} Z`;

// French double doors: two leaves of glass.
const doors = [0, 1].map((i) => {
    const x = DOOR.x + (DOOR.w / 2) * i;
    return { x, glass: { x: r2(x + 1.3), y: DOOR.y + 2.4, w: r2(DOOR.w / 2 - 2.6), h: DOOR.h - 5.8 } };
});

const holes = [
    ...doors.map((d) => rect(d.glass.x, d.glass.y, d.glass.w, d.glass.h)),
    ...windows.map((w) => rect(w.x, WIN.top, w.w, WIN.sill - WIN.top)),
];
const backWall = `${rect(BACK.l, BACK.ceiling, BACK.r - BACK.l, BACK.floor - BACK.ceiling)} ${holes.join(" ")}`;
// The side walls, ceiling, and floor run well past the stage edges, so wide viewports
// see more of the room in the same perspective instead of a stretched one.
const X0 = -120;
const X1 = 220;
// Height of a back-wall line (y) where it meets the side walls at x.
const sideY = (y: number, x: number) => r2(V.y + (y - V.y) * ((x - V.x) / ((x < V.x ? BACK.l : BACK.r) - V.x)));

const leftWall = quad([
    [X0, sideY(BACK.ceiling, X0)],
    [BACK.l, BACK.ceiling],
    [BACK.l, BACK.floor],
    [X0, sideY(BACK.floor, X0)],
]);
const rightWall = quad([
    [X1, sideY(BACK.ceiling, X1)],
    [BACK.r, BACK.ceiling],
    [BACK.r, BACK.floor],
    [X1, sideY(BACK.floor, X1)],
]);
const ceiling = quad([
    [X0, -400],
    [X1, -400],
    [X1, sideY(BACK.ceiling, X1)],
    [BACK.r, BACK.ceiling],
    [BACK.l, BACK.ceiling],
    [X0, sideY(BACK.ceiling, X0)],
]);

const FLOOR_END = 500;
const floorPoly = `${BACK.l},${BACK.floor} ${BACK.r},${BACK.floor} ${X1},${sideY(BACK.floor, X1)} ${X1},${FLOOR_END} ${X0},${FLOOR_END} ${X0},${sideY(BACK.floor, X0)}`;
// Wood floor: plank seams running toward the vanishing point.
const toFront = (FLOOR_END - V.y) / (BACK.floor - V.y);
const planks = Array.from({ length: 45 }, (_, i) => {
    const x = -60 + i * 5;
    return line(x, BACK.floor, r2(V.x + (x - V.x) * toFront), FLOOR_END);
});

// A rug in the middle of the floor, drawn in perspective, with an inset border.
const onFloor = (x: number, y: number) => r2(V.x + (x - V.x) * ((y - V.y) / (BACK.floor - V.y)));
const rugQuad = (l: number, r: number, back: number) =>
    quad([
        [onFloor(l, back), back],
        [onFloor(r, back), back],
        [onFloor(r, 104), 104],
        [onFloor(l, 104), 104],
    ]);
const rug = rugQuad(32, 68, 84);
const rugBorder = rugQuad(33.6, 66.4, 85.2);

// Moonlight through the glass, falling on the floor a little in front of each opening
// and slanting away from the moon (which hangs to the left).
const beam = (l: number, r: number) =>
    quad([
        [onFloor(l + 3, 82), 82],
        [onFloor(r + 3, 82), 82],
        [onFloor(r + 9, 96), 96],
        [onFloor(l + 9, 96), 96],
    ]);
const beams = [...doors.map((d) => beam(d.glass.x, d.glass.x + d.glass.w)), ...windows.map((w) => beam(w.x, w.x + w.w))];

// White trim.
const frames: Line[] = [];
const box = (x: number, y: number, w: number, h: number) =>
    frames.push(line(x, y, x + w, y), line(x + w, y, x + w, y + h), line(x + w, y + h, x, y + h), line(x, y + h, x, y));
windows.forEach((w) => {
    box(w.x, WIN.top, w.w, WIN.sill - WIN.top);
    frames.push(line(w.split, WIN.top, w.split, WIN.sill));
});

// Doors: outer frame, the meeting stile, and a 3×5 grid of lites in each.
const doorTrim = [
    line(DOOR.x, DOOR.y + DOOR.h, DOOR.x, DOOR.y),
    line(DOOR.x, DOOR.y, DOOR.x + DOOR.w, DOOR.y),
    line(DOOR.x + DOOR.w, DOOR.y, DOOR.x + DOOR.w, DOOR.y + DOOR.h),
    line(DOOR.x + DOOR.w / 2, DOOR.y, DOOR.x + DOOR.w / 2, DOOR.y + DOOR.h),
];
const lites: Line[] = [];
for (const { glass: g } of doors) {
    for (let c = 1; c < 3; c++) {
        const x = r2(g.x + (g.w * c) / 3);
        lites.push(line(x, g.y, x, g.y + g.h));
    }
    for (let r = 1; r < 5; r++) {
        const y = r2(g.y + (g.h * r) / 5);
        lites.push(line(g.x, y, g.x + g.w, y));
    }
}
const doorSlab = `${rect(DOOR.x, DOOR.y, DOOR.w, DOOR.h)} ${doors.map((d) => rect(d.glass.x, d.glass.y, d.glass.w, d.glass.h)).join(" ")}`;
const knobX = r2(DOOR.x + DOOR.w / 2 - 0.65);
const knobY = r2(DOOR.y + DOOR.h * 0.52);

const corners = [line(BACK.l, BACK.ceiling, BACK.l, BACK.floor), line(BACK.r, BACK.ceiling, BACK.r, BACK.floor)];
const crown = [
    line(X0, sideY(BACK.ceiling, X0), BACK.l, BACK.ceiling),
    line(BACK.l, BACK.ceiling, BACK.r, BACK.ceiling),
    line(BACK.r, BACK.ceiling, X1, sideY(BACK.ceiling, X1)),
];
const baseboards = [
    line(X0, sideY(BACK.floor, X0), BACK.l, BACK.floor),
    line(BACK.l, BACK.floor, BACK.r, BACK.floor),
    line(BACK.r, BACK.floor, X1, sideY(BACK.floor, X1)),
];
---

<svg class="room" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <defs>
        <linearGradient id="glass-grad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#bcd4ff" stop-opacity="0.06" />
            <stop offset="0.45" stop-color="#bcd4ff" stop-opacity="0.015" />
            <stop offset="0.5" stop-color="#ffffff" stop-opacity="0.05" />
            <stop offset="0.56" stop-color="#bcd4ff" stop-opacity="0.015" />
            <stop offset="1" stop-color="#ffd9a8" stop-opacity="0.05" />
        </linearGradient>
        <linearGradient id="wall-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#2e201d" />
            <stop offset="1" stop-color="#3f2b24" />
        </linearGradient>
        <linearGradient id="floor-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#1f150f" />
            <stop offset="1" stop-color="#2a1b12" />
        </linearGradient>
        <linearGradient id="beam-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#b9c8ff" stop-opacity="0.13" />
            <stop offset="1" stop-color="#b9c8ff" stop-opacity="0" />
        </linearGradient>
        <clipPath id="floor-clip"><polygon points={floorPoly} /></clipPath>
    </defs>

    <g class="glass">
        {holes.map((h) => <path d={h} />)}
    </g>
    <g class="glass-sheen">
        {holes.map((h) => <path d={h} fill="url(#glass-grad)" />)}
    </g>

    <path class="ceiling" d={ceiling} />
    <path class="wall" d={backWall} fill="url(#wall-grad)" fill-rule="evenodd" />
    <path class="wall wall-side" d={leftWall} fill-rule="evenodd" />
    <path class="wall wall-side" d={rightWall} fill-rule="evenodd" />

    <polygon class="floor" points={floorPoly} fill="url(#floor-grad)" />
    <g class="planks" clip-path="url(#floor-clip)">{planks.map((l) => <line {...l} />)}</g>
    <path class="rug" d={rug} clip-path="url(#floor-clip)" />
    <path class="rug-border" d={rugBorder} clip-path="url(#floor-clip)" />
    <g class="moonbeams" clip-path="url(#floor-clip)">{beams.map((d) => <path d={d} fill="url(#beam-grad)" />)}</g>

    <path class="door-slab" d={doorSlab} fill-rule="evenodd" />
    <g class="trim lites">{lites.map((l) => <line {...l} />)}</g>
    <g class="trim door-trim">{doorTrim.map((l) => <line {...l} />)}</g>
    <line class="knob" x1={knobX} y1={knobY} x2={knobX + 0.01} y2={knobY} />
    <line class="knob" x1={knobX} y1={knobY - 3} x2={knobX + 0.01} y2={knobY - 3} />

    <g class="trim frames">{frames.map((l) => <line {...l} />)}</g>
    <g class="corners">{corners.map((l) => <line {...l} />)}</g>
    <g class="trim crown">{crown.map((l) => <line {...l} />)}</g>
    <g class="trim baseboards">{baseboards.map((l) => <line {...l} />)}</g>
</svg>

