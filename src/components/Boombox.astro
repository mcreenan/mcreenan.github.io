<button class="boombox" id="boombox" type="button" aria-pressed="false" aria-label="Play music">
    <span class="bb-handle" aria-hidden="true"></span>
    <span class="bb-body" aria-hidden="true">
        <span class="bb-speaker"><span class="bb-cone"></span></span>
        <span class="bb-middle">
            <span class="bb-lcd" id="bb-lcd">▶ PLAY</span>
            <span class="bb-tape">
                <span class="bb-reel"></span>
                <span class="bb-reel"></span>
            </span>
        </span>
        <span class="bb-speaker"><span class="bb-cone"></span></span>
    </span>
</button>
