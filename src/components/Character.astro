<button class="me" id="me" type="button" aria-label="Matt, with AirPods in and a laptop. Click to say hi.">
    <span class="me-bubble" id="me-bubble" aria-live="polite"></span>
    <span class="me-notes" id="me-notes" aria-hidden="true"></span>
    <svg viewBox="0 0 700 840" aria-hidden="true">
        <defs>
            <linearGradient id="lid" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#3a3d5c" />
                <stop offset="1" stop-color="#1a1b2e" />
            </linearGradient>
            <radialGradient id="screen-spill" cx="0.5" cy="1" r="0.8">
                <stop offset="0" stop-color="#9fc4ff" stop-opacity="0.5" />
                <stop offset="0.6" stop-color="#9fc4ff" stop-opacity="0.12" />
                <stop offset="1" stop-color="#9fc4ff" stop-opacity="0" />
            </radialGradient>
            <!-- Trims the art's own T-shirt off, leaving head and neck (image-local coords). -->
            <clipPath id="me-neck">
                <path transform="translate(70 112)" d="M-50 -50 H 610 V 490 L 345 510 L 290 560 H 150 L 95 500 L 55 450 L 42 400 H -50 Z" />
            </clipPath>
            <radialGradient id="beanbag" cx="0.45" cy="0.3" r="0.8">
                <stop offset="0" stop-color="#a8733a" />
                <stop offset="0.6" stop-color="#8a5a28" />
                <stop offset="1" stop-color="#5e3a1a" />
            </radialGradient>
        </defs>

        <!-- Big comfy beanbag, sunk into from behind. -->
        <path
            class="beanbag"
            d="M-40 880 C -80 760, -50 560, 50 500 C 150 444, 550 444, 650 500 C 750 560, 780 760, 740 880 Z"
            fill="url(#beanbag)"
        />
        <path class="beanbag-seam" d="M120 478 C 90 600, 80 740, 96 880 M580 478 C 610 600, 620 740, 604 880" />

        <!--
            The avatar art is drawn with the head tilted ~15°, so the head is rotated
            upright (AirPods in both ears) and set on a neck that drops
            straight into the hoodie collar. The hoodie is drawn over the base of the neck,
            and everything bobs as one piece.
        -->
        <g class="me-upper">
            <path class="hood-back" d="M200 650 C 200 530, 270 505, 350 505 C 430 505, 500 530, 500 650 Z" />
            <g transform="translate(15 -80) rotate(-15 350 384)">
                <image href="/images/avatar-cut.webp" x="70" y="112" width="560" height="545" clip-path="url(#me-neck)" />
            </g>
            <g class="airpods">
                <g>
                    <rect class="airpod-stem" x="134" y="386" width="12" height="60" rx="6" />
                    <ellipse class="airpod-bud" cx="146" cy="384" rx="16" ry="14" />
                    <circle class="airpod-grill" cx="150" cy="381" r="4" />
                </g>
                <g>
                    <rect class="airpod-stem" x="530" y="392" width="12" height="60" rx="6" />
                    <ellipse class="airpod-bud" cx="530" cy="390" rx="16" ry="14" />
                    <circle class="airpod-grill" cx="526" cy="387" r="4" />
                </g>
            </g>
            <g class="me-hoodie">
                <path
                    class="me-torso"
                    d="M0 880 C 2 760, 20 680, 90 640 C 140 612, 196 578, 236 574 C 262 600, 304 612, 350 612 C 396 612, 438 600, 464 574 C 504 578, 560 612, 610 640 C 680 680, 698 760, 700 880 Z"
                />
                <path class="me-hood" d="M228 570 C 256 612, 300 626, 350 626 C 400 626, 444 612, 472 570" />
                <path class="me-crease" d="M90 700 C 110 750, 116 810, 112 880 M610 700 C 590 750, 584 810, 588 880" />
                <path class="me-string" d="M318 632 C 314 652, 322 672, 314 700 M382 632 C 386 652, 378 672, 386 700" />
            </g>
            <ellipse class="me-glow" cx="350" cy="620" rx="300" ry="260" fill="url(#screen-spill)" />
        </g>

        <!-- The front of the beanbag, puffed up around his lap. -->
        <path class="beanbag" d="M-60 880 C -40 790, 110 770, 350 784 C 590 770, 740 790, 760 880 Z" fill="url(#beanbag)" />

        <g class="laptop">
            <rect x="120" y="646" width="460" height="230" rx="18" fill="url(#lid)" />
            <rect x="120" y="646" width="460" height="6" rx="3" fill="#9fc4ff" opacity="0.55" />
            <g class="sticker" transform="rotate(-8 230 720)">
                <rect x="178" y="688" width="104" height="44" rx="8" fill="#8b7bff" />
                <text x="230" y="718" text-anchor="middle" fill="#14123a">SHOUT!</text>
            </g>
            <g class="sticker" transform="rotate(6 440 740)">
                <circle cx="440" cy="740" r="38" fill="#7fd4ff" />
                <text x="440" y="754" text-anchor="middle" fill="#0c0a24" font-size="40">λ</text>
            </g>
            <g class="sticker" transform="rotate(-3 322 790)">
                <rect x="246" y="768" width="152" height="40" rx="6" fill="#ffb86b" />
                <text x="322" y="795" text-anchor="middle" fill="#2a1406" font-size="21">JOSH/ALLEN</text>
            </g>
            <g class="sticker" transform="rotate(10 530 684)">
                <rect x="498" y="666" width="64" height="36" rx="18" fill="#1d4ed8" />
                <text x="530" y="691" text-anchor="middle" fill="#fff" font-size="21">BUF</text>
            </g>
        </g>
    </svg>
</button>
