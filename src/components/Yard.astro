---
// A moonlit, snowy backyard seen through the glass: tree line, trees, a picket fence,
// and a light snowfall.

// Deterministic RNG so the yard is identical on every build.
function mulberry32(a: number) {
    return () => {
        a |= 0;
        a = (a + 0x6d2b79f5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
}
const rand = mulberry32(2026);
const between = (min: number, max: number) => min + rand() * (max - min);
const r1 = (n: number) => Math.round(n * 10) / 10;

const W = 1600;
const H = 500;
const GROUND = H - 70;

// Distant tree line: overlapping canopy blobs.
const farCanopy: { cx: number; cy: number; r: number }[] = [];
for (let x = -40; x < W + 40; x += between(22, 38)) {
    farCanopy.push({ cx: r1(x), cy: r1(GROUND - between(80, 150)), r: r1(between(34, 60)) });
}

// Mid-ground trees: dark pines and round deciduous trees against the tree line.
interface Tree {
    kind: "pine" | "round";
    x: number;
    h: number;
    w: number;
    blobs: { cx: number; cy: number; r: number }[];
}
const trees: Tree[] = [];
for (const x of [60, 250, 420, 610, 800, 980, 1150, 1330, 1500]) {
    const kind = rand() < 0.5 ? "pine" : "round";
    const h = between(190, 300);
    const w = kind === "pine" ? between(70, 110) : between(130, 190);
    const blobs =
        kind === "round"
            ? Array.from({ length: 6 }, () => ({
                  cx: r1(x + between(-w / 3, w / 3)),
                  cy: r1(GROUND - h + between(30, 110)),
                  r: r1(between(w / 4, w / 2.4)),
              }))
            : [];
    trees.push({ kind, x: r1(x + between(-30, 30)), h: r1(h), w: r1(w), blobs });
}

const pines = (t: Tree) =>
    [0, 1, 2, 3].map((i) => {
        const top = GROUND - t.h + i * t.h * 0.2;
        const half = (t.w / 2) * (0.45 + i * 0.2);
        return `${r1(t.x - half)},${r1(top + t.h * 0.34)} ${t.x},${r1(top)} ${r1(t.x + half)},${r1(top + t.h * 0.34)}`;
    });

// Wooden picket fence along the back of the lawn: one path of pointed pickets.
const FENCE = { top: GROUND - 34, bottom: GROUND + 14, gap: 16, w: 10 };
const pickets = Array.from({ length: Math.ceil((W + 80) / FENCE.gap) }, (_, i) => {
    const x = i * FENCE.gap - 40;
    return `M${x},${FENCE.bottom} V${FENCE.top + 5} L${x + FENCE.w / 2},${FENCE.top} L${x + FENCE.w},${FENCE.top + 5} V${FENCE.bottom} Z`;
}).join(" ");
---

<div class="yard" aria-hidden="true">
    <div class="lawn"></div>
    <svg class="yard-svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice">
        <g class="far-trees">
            {farCanopy.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} />)}
            <rect x="-40" y={GROUND - 110} width={W + 80} height={H} />
        </g>

        <g class="trees">
            {
                trees.map((t) =>
                    t.kind === "pine" ? (
                        <g class="tree">
                            <rect x={t.x - 5} y={GROUND - 40} width="10" height="60" />
                            {pines(t).map((p) => <polygon points={p} />)}
                        </g>
                    ) : (
                        <g class="tree">
                            <rect x={t.x - 7} y={GROUND - t.h * 0.55} width="14" height={t.h * 0.55 + 20} />
                            {t.blobs.map((b) => <circle cx={b.cx} cy={b.cy} r={b.r} />)}
                        </g>
                    ),
                )
            }
        </g>

        <g class="fence">
            <rect class="fence-rail" x="-40" y={FENCE.top + 10} width={W + 80} height="5" />
            <rect class="fence-rail" x="-40" y={FENCE.bottom - 14} width={W + 80} height="5" />
            <path class="fence-pickets" d={pickets} />
            <rect class="fence-snow" x="-40" y={FENCE.top + 8} width={W + 80} height="3" rx="1.5" />
        </g>
    </svg>
    <!-- Buffalo, so: a slow, light snowfall. -->
    <div class="snow"></div>
</div>
