---
// The night-time backyard seen through the sunroom glass.

// Deterministic RNG so the yard is identical on every build.
function mulberry32(a: number) {
    return () => {
        a |= 0;
        a = (a + 0x6d2b79f5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
}
const rand = mulberry32(2026);
const between = (min: number, max: number) => min + rand() * (max - min);
const r1 = (n: number) => Math.round(n * 10) / 10;

const W = 1600;
const H = 500;
const GROUND = H - 70;

// Distant tree line: overlapping canopy blobs.
const farCanopy: { cx: number; cy: number; r: number }[] = [];
for (let x = -40; x < W + 40; x += between(22, 38)) {
    farCanopy.push({ cx: r1(x), cy: r1(GROUND - between(80, 150)), r: r1(between(34, 60)) });
}

// Mid-ground trees: cedars and round deciduous trees, some with pale birch-like trunks.
interface Tree {
    kind: "pine" | "round";
    x: number;
    h: number;
    w: number;
    blobs: { cx: number; cy: number; r: number }[];
    pale: boolean;
}
const trees: Tree[] = [];
for (const x of [40, 230, 400, 590, 760, 930, 1080, 1480]) {
    const kind = rand() < 0.45 ? "pine" : "round";
    const h = between(190, 310);
    const w = kind === "pine" ? between(70, 110) : between(120, 180);
    const blobs =
        kind === "round"
            ? Array.from({ length: 6 }, () => ({
                  cx: r1(x + between(-w / 3, w / 3)),
                  cy: r1(GROUND - h + between(30, 110)),
                  r: r1(between(w / 4, w / 2.4)),
              }))
            : [];
    trees.push({ kind, x: r1(x + between(-30, 30)), h: r1(h), w: r1(w), blobs, pale: kind === "round" && rand() < 0.6 });
}

const pines = (t: Tree) =>
    [0, 1, 2, 3].map((i) => {
        const top = GROUND - t.h + i * t.h * 0.2;
        const half = (t.w / 2) * (0.45 + i * 0.2);
        return `${r1(t.x - half)},${r1(top + t.h * 0.34)} ${t.x},${r1(top)} ${r1(t.x + half)},${r1(top + t.h * 0.34)}`;
    });

// Wooden A-frame swing set out on the lawn.
const swing = { x: 1180, w: 190, h: 150, ground: GROUND + 40 };
---

<div class="yard" aria-hidden="true">
    <div class="lawn"></div>
    <svg class="yard-svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice">
        <g class="far-trees">
            {farCanopy.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} />)}
            <rect x="-40" y={GROUND - 110} width={W + 80} height={H} />
        </g>

        <g class="shed">
            <rect x="30" y={GROUND - 96} width="130" height="116" />
            <polygon points={`18,${GROUND - 96} 95,${GROUND - 140} 172,${GROUND - 96}`} />
            <rect class="shed-window" x="72" y={GROUND - 74} width="40" height="30" />
        </g>

        <g class="chain-link">
            <line x1="-40" y1={GROUND - 30} x2={W + 40} y2={GROUND - 30} />
            <line x1="-40" y1={GROUND + 4} x2={W + 40} y2={GROUND + 4} />
            {Array.from({ length: 80 }, (_, i) => <line x1={i * 20 - 20} y1={GROUND - 30} x2={i * 20 - 20} y2={GROUND + 4} />)}
        </g>

        <g class="trees">
            {
                trees.map((t) =>
                    t.kind === "pine" ? (
                        <g class="tree">
                            <rect x={t.x - 5} y={GROUND - 40} width="10" height="60" />
                            {pines(t).map((p) => <polygon points={p} />)}
                        </g>
                    ) : (
                        <g class="tree">
                            <rect class:list={[{ pale: t.pale }]} x={t.x - 7} y={GROUND - t.h * 0.55} width="14" height={t.h * 0.55 + 20} />
                            {t.blobs.map((b) => <circle cx={b.cx} cy={b.cy} r={b.r} />)}
                        </g>
                    ),
                )
            }
        </g>

        <g class="swing-set">
            <line x1={swing.x} y1={swing.ground} x2={swing.x + 22} y2={swing.ground - swing.h} />
            <line x1={swing.x + 44} y1={swing.ground} x2={swing.x + 22} y2={swing.ground - swing.h} />
            <line x1={swing.x + swing.w} y1={swing.ground} x2={swing.x + swing.w - 22} y2={swing.ground - swing.h} />
            <line x1={swing.x + swing.w - 44} y1={swing.ground} x2={swing.x + swing.w - 22} y2={swing.ground - swing.h} />
            <line class="beam" x1={swing.x + 10} y1={swing.ground - swing.h} x2={swing.x + swing.w - 10} y2={swing.ground - swing.h} />
            <path class="slide" d={`M${swing.x + swing.w - 30} ${swing.ground - 70} L${swing.x + swing.w + 90} ${swing.ground - 4}`} />
            <line x1={swing.x + swing.w - 60} y1={swing.ground - 70} x2={swing.x + swing.w - 22} y2={swing.ground - 70} />
            <g class="swing">
                <line x1={swing.x + 78} y1={swing.ground - swing.h} x2={swing.x + 78} y2={swing.ground - 40} />
                <line x1={swing.x + 112} y1={swing.ground - swing.h} x2={swing.x + 112} y2={swing.ground - 40} />
                <rect x={swing.x + 72} y={swing.ground - 42} width="46" height="7" rx="3" />
            </g>
        </g>

        <g class="trees big-tree">
            <g class="tree">
                <rect x="1540" y={GROUND - 360} width="34" height="460" />
                <circle cx="1560" cy={GROUND - 390} r="120" />
                <circle cx="1470" cy={GROUND - 330} r="90" />
                <circle cx="1620" cy={GROUND - 300} r="110" />
                <circle cx="1500" cy={GROUND - 440} r="80" />
            </g>
        </g>
    </svg>
</div>
