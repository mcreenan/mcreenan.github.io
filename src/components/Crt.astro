<div class="crt" id="crt">
    <div class="crt-bezel">
        <div class="crt-screen">
            <div class="term" id="term">
                <div class="term-out" id="term-out" role="log" aria-live="polite"></div>
                <form class="term-line" id="term-form" autocomplete="off">
                    <label class="ps1" for="term-input">guest@creenan:~$</label>
                    <input
                        id="term-input"
                        name="cmd"
                        type="text"
                        spellcheck="false"
                        autocapitalize="off"
                        autocorrect="off"
                        enterkeyhint="send"
                    />
                </form>
            </div>
            <div class="crt-scanlines" aria-hidden="true"></div>
            <div class="crt-glare" aria-hidden="true"></div>
        </div>
        <div class="crt-chin">
            <span class="crt-brand">CREENAN·TERM <em>2000</em></span>
            <span class="crt-keys">
                <button type="button" data-cmd="about">about</button>
                <button type="button" data-cmd="projects">projects</button>
                <button type="button" data-cmd="work">work</button>
                <button type="button" data-cmd="contact">contact</button>
            </span>
            <span class="crt-led" aria-hidden="true"></span>
        </div>
    </div>
    <div class="crt-stand" aria-hidden="true"></div>
    <div class="sticky-note" aria-hidden="true">type<br /><b>help</b> :)</div>
</div>
