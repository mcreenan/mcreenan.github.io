---
import { BACK, RIGHT_WALL, WIN, WINDOWS, depthScale } from "../data/room";

const pct = (n: number) => `${Math.round(n * 100) / 100}%`;

// Floor lamp in the front-left corner, about 60% of the wall height, scaled up for
// standing a little in front of the back wall. The glow is centered on its shade.
const LAMP = { x: 4, floor: 86 };
const lampH = 0.6 * (BACK.floor - BACK.ceiling) * depthScale(LAMP.floor);
const lampStyle = `left:${pct(LAMP.x)};bottom:${pct(100 - LAMP.floor)};height:${pct(lampH)}`;
const glowStyle = `left:${pct(LAMP.x)};top:${pct(LAMP.floor - lampH * 0.9)}`;

// Pennants hang centered over the right window, between the ceiling line and its head.
const penWin = WINDOWS[1];
const pennantStyle = `left:${pct(penWin.x + penWin.w / 2)};top:${pct(BACK.ceiling + (WIN.top - BACK.ceiling) * 0.2)}`;

// Low bookshelf against the back wall, in the gap between the desk's right end and
// the right corner (its left edge follows the desk; see .bookshelf).
const shelfStyle = `bottom:${pct(100 - BACK.floor)};right:${pct(100 - BACK.r + 1.5)}`;

// Family photo hung on the strip of wall right of the window, at eye level.
const photoStyle = `left:${pct((RIGHT_WALL.l + RIGHT_WALL.r) / 2)};top:${pct(WIN.top + 8)};width:${pct((RIGHT_WALL.r - RIGHT_WALL.l) * 0.62)}`;

// Dust motes drifting in the lamp light (deterministic, so builds match).
const motes = Array.from({ length: 9 }, (_, i) => ({
    left: (i * 37) % 100,
    top: 20 + ((i * 53) % 70),
    delay: -((i * 1.7) % 9).toFixed(1),
    dur: 8 + (i % 4) * 1.5,
}));

// Felt pennant: a header strip, then a triangle tapering to a point on the centerline,
// with the long edges sagging slightly like hung felt.
const BODY = "M20 0 Q 110 20, 198 33 Q 110 48, 20 64 Z";
const pennants = [
    { id: "bills", name: "BILLS", body: "#00338d", header: "#c60c30", size: 22 },
    { id: "sabres", name: "SABRES", body: "#002654", header: "#fcb514", size: 19 },
];
---

<!-- Warm floor lamp in the corner; click it to flip the lights. -->
<div class="lamp-glow" style={glowStyle} aria-hidden="true"></div>
<div class="motes" style={glowStyle} aria-hidden="true">
    {motes.map((m) => <i style={`left:${m.left}%;top:${m.top}%;animation-delay:${m.delay}s;animation-duration:${m.dur}s`}></i>)}
</div>
<button class="floor-lamp" id="lamp" type="button" style={lampStyle} aria-pressed="true" aria-label="Floor lamp. Click to toggle the lights.">
    <svg viewBox="0 0 100 460" aria-hidden="true">
        <defs>
            <linearGradient id="shade-lit" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#e9b574" />
                <stop offset="0.5" stop-color="#ffe6b5" />
                <stop offset="1" stop-color="#e9b574" />
            </linearGradient>
        </defs>
        <rect class="lamp-pole" x="48" y="84" width="4" height="362" rx="2" />
        <rect class="lamp-pole" x="46" y="250" width="8" height="10" rx="2" />
        <ellipse class="lamp-base" cx="50" cy="450" rx="30" ry="8" />
        <ellipse class="lamp-base-hi" cx="50" cy="447" rx="22" ry="3" />
        <!-- Linen drum shade, glowing from inside, with its bright open bottom. -->
        <path class="lamp-shade" d="M20 6 H80 L94 88 H6 Z" fill="url(#shade-lit)" />
        <ellipse class="lamp-rim" cx="50" cy="6" rx="30" ry="3" />
        <ellipse class="lamp-mouth" cx="50" cy="88" rx="44" ry="6" />
    </svg>
</button>

<!-- Bills and Sabres pennants over the right window: football with the family, hockey alone. -->
<div class="pennants" style={pennantStyle} aria-hidden="true">
    {
        pennants.map((p) => (
            <svg class="pennant" viewBox="0 0 200 64">
                <defs>
                    <linearGradient id={`felt-${p.id}`} x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#fff" stop-opacity="0.12" />
                        <stop offset="0.5" stop-color="#fff" stop-opacity="0" />
                        <stop offset="1" stop-color="#000" stop-opacity="0.3" />
                    </linearGradient>
                </defs>
                <path d={BODY} fill={p.body} />
                <path d={BODY} fill={`url(#felt-${p.id})`} />
                <path d="M104 0 Q 118 30, 104 64" fill="none" stroke="#000" stroke-opacity="0.12" stroke-width="10" />
                <rect x="0" y="0" width="22" height="64" rx="1.5" fill={p.header} />
                <rect x="0" y="0" width="22" height="64" rx="1.5" fill={`url(#felt-${p.id})`} />
                <text x="84" y="39" text-anchor="middle" font-size={p.size} fill="#fff" stroke={p.header} stroke-width="1.2" paint-order="stroke">
                    {p.name}
                </text>
                <circle class="tack" cx="11" cy="7" r="3" />
                <circle class="tack" cx="11" cy="57" r="3" />
            </svg>
        ))
    }
</div>

<!-- Bookshelf under the right window: two rows of books, with a plant and a stack on top. -->
<svg class="bookshelf" style={shelfStyle} viewBox="0 0 400 250" aria-hidden="true">
    <g class="shelf-plant">
        <path d="M30 40 L34 16 H64 L68 40 Z" fill="#a85a40" />
        <ellipse cx="40" cy="8" rx="7" ry="13" transform="rotate(-28 40 8)" />
        <ellipse cx="58" cy="6" rx="7" ry="13" transform="rotate(26 58 6)" />
        <ellipse cx="49" cy="0" rx="6" ry="14" />
    </g>
    <rect x="236" y="28" width="104" height="12" rx="2" fill="#35506b" />
    <rect x="244" y="17" width="88" height="11" rx="2" fill="#7a3b35" />
    <rect x="0" y="40" width="400" height="10" rx="2" fill="#6b4a33" />
    <rect x="8" y="50" width="384" height="192" fill="#4a3122" />
    <rect x="22" y="62" width="170" height="80" rx="2" fill="#1d130d" />
    <rect x="208" y="62" width="170" height="80" rx="2" fill="#1d130d" />
    <rect x="22" y="152" width="170" height="80" rx="2" fill="#1d130d" />
    <rect x="208" y="152" width="170" height="80" rx="2" fill="#1d130d" />
    <g class="books">
        <rect x="30" y="76" width="18" height="66" fill="#7a3b35" />
        <rect x="50" y="84" width="16" height="58" fill="#35506b" />
        <rect x="68" y="72" width="20" height="70" fill="#8a7a4a" />
        <rect x="90" y="82" width="15" height="60" fill="#4e6b4a" />
        <rect x="107" y="78" width="19" height="64" fill="#5e4a6b" />
        <rect x="134" y="80" width="17" height="62" fill="#8a5a3a" transform="rotate(14 151 142)" />
        <rect x="222" y="124" width="120" height="18" rx="2" fill="#6b4a6b" />
        <rect x="228" y="108" width="108" height="16" rx="2" fill="#8a7a4a" />
        <rect x="224" y="94" width="114" height="14" rx="2" fill="#35506b" />
        <rect x="216" y="168" width="17" height="64" fill="#4e6b4a" />
        <rect x="235" y="160" width="20" height="72" fill="#7a3b35" />
        <rect x="257" y="172" width="15" height="60" fill="#8a7a4a" />
        <rect x="274" y="164" width="18" height="68" fill="#35506b" />
        <rect x="294" y="170" width="16" height="62" fill="#5e4a6b" />
        <rect x="30" y="214" width="130" height="18" rx="2" fill="#35506b" />
        <rect x="36" y="198" width="118" height="16" rx="2" fill="#8a5a3a" />
    </g>
    <rect x="16" y="242" width="14" height="8" fill="#2a1b12" />
    <rect x="370" y="242" width="14" height="8" fill="#2a1b12" />
</svg>

<!-- Family photo on the wall: Matt, his wife, and their two kids. -->
<svg class="family-photo" style={photoStyle} viewBox="0 0 40 50" aria-hidden="true">
    <path d="M8 13 L20 2 L32 13" fill="none" stroke="#8a7a6a" stroke-width="0.8" />
    <circle cx="20" cy="2" r="1.2" fill="#9a9a9a" />
    <rect x="1" y="12" width="38" height="36" rx="1.5" fill="#6b4a32" />
    <rect x="5" y="16" width="30" height="28" fill="#2c3552" />
    <g fill="#8a6fd1">
        <path d="M5 44 C 5 29, 16 29, 16 44 Z" />
        <path d="M24 44 C 24 29, 35 29, 35 44 Z" />
    </g>
    <g fill="#d9844e">
        <path d="M13.5 44 C 13.5 34, 20 34, 20 44 Z" />
        <path d="M20 44 C 20 34, 26.5 34, 26.5 44 Z" />
    </g>
    <g fill="#e8c7a4">
        <circle cx="10.5" cy="24.5" r="3.6" />
        <circle cx="29.5" cy="24.5" r="3.6" />
        <circle cx="16.8" cy="31" r="2.7" />
        <circle cx="23.2" cy="31" r="2.7" />
    </g>
</svg>

<!-- Black sit-stand desk against the back wall, holding the terminal, the boombox, and a mug. -->
<div class="desk" aria-hidden="true">
    <span class="desk-top"></span>
    <span class="desk-leg desk-leg-l"><i></i></span>
    <span class="desk-leg desk-leg-r"><i></i></span>
    <span class="mug"><i></i><i></i></span>
</div>
